@article{https://doi.org/10.1002/pbc.27874,
    author = {Cheng, Aaron N. and Bao, Erik L. and Fiorini, Claudia and Sankaran, Vijay G.},
    title = {Macrothrombocytopenia associated with a rare GFI1B missense variant confounding the presentation of immune thrombocytopenia},
    journal = {Pediatric Blood \& Cancer},
    volume = {66},
    number = {9},
    pages = {e27874},
    keywords = {bone marrow failure, genetics, GFI1B, hematopoiesis, immune thrombocytopenia, thrombocytopenia},
    doi = {https://doi.org/10.1002/pbc.27874},
    url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/pbc.27874},
    eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/pbc.27874},
    abstract = {Growth factor-independent 1B (GFI1B) variants are a rare cause of thrombocytopenia. We report on a male child who was initially diagnosed with immune thrombocytopenia. However, subtle clinical signs led to suspicion of a genetic cause of thrombocytopenia. Gene panel sequencing revealed a rare variant in GFI1B (C168F), which has recently been reported in several families with thrombocytopenia. We demonstrate that this variant significantly alters platelet parameters in population studies. This case highlights how diagnoses of exclusion, such as immune thrombocytopenia, can be confounded by genetic variation. Our understanding of blood disorders will undoubtedly evolve from an increased knowledge of human genetic variation.},
    year = {2019},
    pdf = {cheng_gfi1b.pdf},
    selected = {true}
}

@article{https://doi.org/10.15252/emmm.201910316,
    author = {Bao, Erik L and Cheng, Aaron N and Sankaran, Vijay G},
    title = {The genetics of human hematopoiesis and its disruption in disease},
    journal = {EMBO Molecular Medicine},
    volume = {11},
    number = {8},
    pages = {e10316},
    keywords = {blood disorders, genetics, genome‐wide association studies, hematopoiesis},
    doi = {https://doi.org/10.15252/emmm.201910316},
    url = {https://www.embopress.org/doi/abs/10.15252/emmm.201910316},
    eprint = {https://www.embopress.org/doi/pdf/10.15252/emmm.201910316},
    abstract = {Hematopoiesis, or the process of blood cell production, is a paradigm of multi‐lineage cellular differentiation that has been extensively studied, yet in many aspects remains incompletely understood. Nearly all clinically measured hematopoietic traits exhibit extensive variation and are highly heritable, underscoring the importance of genetic variation in these processes. This review explores how human genetics have illuminated our understanding of hematopoiesis in health and disease. The study of rare mutations in blood and immune disorders has elucidated novel roles for regulators of hematopoiesis and uncovered numerous important molecular pathways, as seen through examples such as Diamond‐Blackfan anemia and the GATA2 deficiency syndromes. Additionally, population studies of common genetic variation have revealed mechanisms by which human hematopoiesis can be modulated. We discuss advances in functionally characterizing common variants associated with blood cell traits and discuss therapeutic insights, such as the discovery of BCL11A as a modulator of fetal hemoglobin expression. Finally, as genetic techniques continue to evolve, we discuss the prospects, challenges, and unanswered questions that lie ahead in this burgeoning field.},
    year = {2019},
    pdf = {cheng_hematopoiesis.pdf},
    selected = {true}
}

@article{ULIRSCH2018930,
    title = {The Genetic Landscape of Diamond-Blackfan Anemia},
    journal = {The American Journal of Human Genetics},
    volume = {103},
    number = {6},
    pages = {930-947},
    year = {2018},
    issn = {0002-9297},
    doi = {https://doi.org/10.1016/j.ajhg.2018.10.027},
    url = {https://www.sciencedirect.com/science/article/pii/S0002929718304038},
    author = {Jacob C. Ulirsch and Jeffrey M. Verboon and Shideh Kazerounian and Michael H. Guo and Daniel Yuan and Leif S. Ludwig and Robert E. Handsaker and Nour J. Abdulhay and Claudia Fiorini and Giulio Genovese and Elaine T. Lim and Aaron Cheng and Beryl B. Cummings and Katherine R. Chao and Alan H. Beggs and Casie A. Genetti and Colin A. Sieff and Peter E. Newburger and Edyta Niewiadomska and Michal Matysiak and Adrianna Vlachos and Jeffrey M. Lipton and Eva Atsidaftos and Bertil Glader and Anupama Narla and Pierre-Emmanuel Gleizes and Marie-Françoise O’Donohue and Nathalie Montel-Lehry and David J. Amor and Steven A. McCarroll and Anne H. O’Donnell-Luria and Namrata Gupta and Stacey B. Gabriel and Daniel G. MacArthur and Eric S. Lander and Monkol Lek and Lydie {Da Costa} and David G. Nathan and Andrei A. Korostelev and Ron Do and Vijay G. Sankaran and Hanna T. Gazda},
    keywords = {human genetics, rare disease, whole-exome sequencing, congenital hypoplastic anemia, Diamond-Blackfan anemia, RNA sequencing, hematopoiesis},
    abstract = {Diamond-Blackfan anemia (DBA) is a rare bone marrow failure disorder that affects 7 out of 1,000,000 live births and has been associated with mutations in components of the ribosome. In order to characterize the genetic landscape of this heterogeneous disorder, we recruited a cohort of 472 individuals with a clinical diagnosis of DBA and performed whole-exome sequencing (WES). We identified relevant rare and predicted damaging mutations for 78% of individuals. The majority of mutations were singletons, absent from population databases, predicted to cause loss of function, and located in 1 of 19 previously reported ribosomal protein (RP)-encoding genes. Using exon coverage estimates, we identified and validated 31 deletions in RP genes. We also observed an enrichment for extended splice site mutations and validated their diverse effects using RNA sequencing in cell lines obtained from individuals with DBA. Leveraging the size of our cohort, we observed robust genotype-phenotype associations with congenital abnormalities and treatment outcomes. We further identified rare mutations in seven previously unreported RP genes that may cause DBA, as well as several distinct disorders that appear to phenocopy DBA, including nine individuals with biallelic CECR1 mutations that result in deficiency of ADA2. However, no new genes were identified at exome-wide significance, suggesting that there are no unidentified genes containing mutations readily identified by WES that explain >5% of DBA-affected case subjects. Overall, this report should inform not only clinical practice for DBA-affected individuals, but also the design and analysis of rare variant studies for heterogeneous Mendelian disorders.},
    pdf = {ulirsch_dba.pdf}
    }